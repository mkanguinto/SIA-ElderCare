# Root environment file used by docker-compose.yml.   cp .env.example .env
# Generate strong secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

JWT_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Key rotation (docs/SECURITY.md): new tokens are signed with JWT_KID; keys in JWT_PREVIOUS_KEYS
# ({"<old kid>":"<old secret>"}) still verify until their tokens expire. Rotate every JWT_KEY_ROTATION_DAYS.
JWT_KID=k1
JWT_PREVIOUS_KEYS=
JWT_REFRESH_KID=r1
JWT_PREVIOUS_REFRESH_KEYS=
JWT_KEY_ROTATED_AT=2026-10-22
JWT_KEY_ROTATION_DAYS=90
# Two tabs refreshing with the same refresh token within this many seconds is not treated as token theft
REFRESH_REUSE_GRACE_SECONDS=10
# Docker secrets instead of the values above: npm run secrets:generate, then
#   docker compose -f docker-compose.yml -f docker-compose.secrets.yml up -d
INTERNAL_SERVICE_TOKEN=change-me-internal-service-token
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database isolation: each service has its own non-superuser login (checkin_svc / alert_svc / clinic_svc).
# *_DB_PASSWORD   = the service's own login     *_DB_ADMIN_PASSWORD = container bootstrap only
CHECKIN_DB_PASSWORD=checkin_pass
ALERT_DB_PASSWORD=alert_pass
CLINIC_DB_PASSWORD=clinic_pass
CARE_DB_PASSWORD=care_pass
AUTH_DB_PASSWORD=auth_pass
CHECKIN_DB_ADMIN_PASSWORD=checkin_admin_pass
ALERT_DB_ADMIN_PASSWORD=alert_admin_pass
CLINIC_DB_ADMIN_PASSWORD=clinic_admin_pass
CARE_DB_ADMIN_PASSWORD=care_admin_pass
AUTH_DB_ADMIN_PASSWORD=auth_admin_pass
SEED_DEMO_DATA=true

# ---- RabbitMQ (message-oriented middleware) ----------------------------------------
# Management UI: http://localhost:15672   vhost: eldercare
RABBITMQ_USER=eldercare
RABBITMQ_PASSWORD=change-me-rabbitmq-password

# OpenWeatherMap - free key at https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=
OPENWEATHER_ONECALL_ENABLED=false
WEATHER_POLL_INTERVAL_MINUTES=30
# Heat / typhoon thresholds are admin-managed alert rules (GET/PATCH /api/alerts/rules), not env vars.

SMS_DRY_RUN=true

# ---- SMS provider -------------------------------------------------------------
# textbee (Android phone as SMS gateway, https://textbee.dev) | none
# Leave empty to auto-pick: textbee if TEXTBEE_API_KEY is set.
SMS_PROVIDER=
# TextBee dashboard -> API Keys / Devices. NEVER commit real values.
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
TEXTBEE_BASE_URL=https://api.textbee.dev/api/v1
TEXTBEE_SIM_SUBSCRIPTION_ID=
# Dashboard -> Webhooks: URL https://<public-gateway>/webhooks/textbee, same secret here
TEXTBEE_WEBHOOK_SECRET=
TEXTBEE_VALIDATE_WEBHOOK=true
# node-red = gateway verifies X-Signature, Node-RED routes by content (Batch 3); alert = straight to the alert service
TEXTBEE_WEBHOOK_TARGET=node-red
# Comma-separated E.164 numbers allowed to receive REAL texts. Outside NODE_ENV=production
# an empty list means every SMS is simulated (protects the demo +63917555010x numbers).
SMS_RECIPIENT_ALLOWLIST=
# Free TextBee plan = 50/day; keep a margin
SMS_DAILY_LIMIT=40
# TextBee timed out after the request left: park in the DLQ for review (false) or resend and risk a duplicate (true)
SMS_RETRY_ON_TIMEOUT=false

# ---- Clinic triage / visits -----------------------------------------------------
ENV_RISK_TTL_HOURS=24
RECENT_VISIT_DAYS=30
VISIT_MAX_DAYS_AHEAD=180
VISIT_TZ_OFFSET=+08:00

# Legacy EMR (defaults to the bundled mock)
LEGACY_EMR_URL=http://mock-legacy-emr:4005/emr
LEGACY_EMR_USERNAME=
LEGACY_EMR_PASSWORD=

# Failure-testing knobs for the mock EMR
MOCK_EMR_DELAY_MS=0
MOCK_EMR_FAIL_RATE=0

# ---- Node-RED EAI layer (Batch 3) -------------------------------------------------
# DLQ dashboard http://localhost:1880/dlq and editor http://localhost:1880/admin (user admin).
# Leave a password empty to keep that page disabled.
DASHBOARD_USER=ops
DASHBOARD_PASSWORD=change-me-dashboard-password
NODE_RED_ADMIN_PASSWORD=change-me-node-red-password
NODE_RED_CREDENTIAL_SECRET=change-me-node-red-credential-secret

# Clinic phone shown to families; gets an SMS notice per contact (must be on SMS_RECIPIENT_ALLOWLIST for real texts)
CLINIC_HOTLINE=
CLINIC_HOTLINE_NAME=RHU Manila health center
CLINIC_HOURS=Mon-Fri 8 AM - 5 PM
