# ---------- API Gateway ----------
PORT=8080
NODE_ENV=development
LOG_LEVEL=info
SERVICE_NAME=api-gateway
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# JWT / OAuth 2.0 -- generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ALGORITHM=HS256
JWT_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ISSUER=eldercare-connect-auth
JWT_AUDIENCE=eldercare-connect-api
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# RS256 mode (external IdP): set JWT_ALGORITHM=RS256 and JWT_PUBLIC_KEY (and JWT_PRIVATE_KEY if the gateway issues tokens)
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Shared secret the gateway sends to internal services (must match every service)
INTERNAL_SERVICE_TOKEN=change-me-internal-service-token

# Internal service addresses (never exposed to clients)
CHECKIN_SERVICE_URL=http://localhost:4001
ALERT_SERVICE_URL=http://localhost:4002
CLINIC_SERVICE_URL=http://localhost:4003
LEGACY_ADAPTER_URL=http://localhost:4004
UPSTREAM_TIMEOUT_MS=5000

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=20

# Accounts (Batch 3a). Empty AUTH_DATABASE_URL -> data/users.json (accounts made in the app are written there).
AUTH_DATABASE_URL=postgres://auth_svc:auth_pass@localhost:5437/auth_db
# Base of the password-reset link sent by SMS
PUBLIC_WEB_URL=http://localhost:3000
# Local testing only: GET /internal/test/account-sms (internal token) returns the last activation code / reset link
ACCOUNT_SMS_CAPTURE=false
# Inactivity lock (minutes): nurses and admin / caregivers and family
SESSION_IDLE_MINUTES_CLINICAL=15
SESSION_IDLE_MINUTES_HOME=30
