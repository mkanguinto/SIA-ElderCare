{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eldercare.connect/contracts/events/checkin.missed.schema.json",
  "title": "checkin.missed",
  "description": "Published by checkin-service's missed check-in job. Consumed by alert-service and clinic-risk-service.",
  "type": "object",
  "required": [
    "eventId",
    "type",
    "occurredAt",
    "source",
    "patient",
    "anomalies",
    "severity",
    "severityScore"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
      "description": "Unique, stable id. Consumers de-duplicate on it (idempotent receiver)."
    },
    "type": {
      "type": "string",
      "const": "checkin.missed"
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "correlationId": {
      "type": "string",
      "maxLength": 128
    },
    "patient": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "fullName": {
          "type": "string",
          "maxLength": 160
        },
        "zipCode": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 10
        },
        "conditions": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "mobilityRestricted": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "assignedClinic": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "lastCheckinAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "anomalies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "level": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "severity": {
      "type": "string",
      "enum": [
        "none",
        "low",
        "moderate",
        "high",
        "critical"
      ]
    },
    "severityScore": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    }
  },
  "additionalProperties": true
}
