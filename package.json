{
  "name": "eldercare-connect",
  "version": "2.0.0",
  "private": true,
  "description": "ElderCare Connect - integrated community-based elderly health monitoring and emergency response platform",
  "scripts": {
    "setup": "node scripts/setup-local.js",
    "start:all": "node scripts/start-all.js",
    "dev": "node scripts/start-all.js",
    "install:all": "node scripts/run-all.js install",
    "test": "node scripts/run-all.js test",
    "smoke": "node testing/e2e-smoke.mjs",
    "sync-shared": "node scripts/sync-shared.js",
    "secrets:generate": "node scripts/generate-secrets.js",
    "up": "docker compose up --build",
    "up:cloud": "docker compose -f docker-compose.yml -f docker-compose.cloud.yml up -d --build",
    "down": "docker compose down",
    "verify:db-isolation": "node scripts/verify-db-isolation.js"
  }
}
