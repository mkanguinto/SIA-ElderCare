PORT=4003
NODE_ENV=development
SERVICE_NAME=clinic-risk-service
LOG_LEVEL=info
DATABASE_URL=postgres://clinic_svc:clinic_pass@localhost:5435/clinic_db
DB_SSL=false
INTERNAL_SERVICE_TOKEN=change-me-internal-service-token
LEGACY_ADAPTER_URL=http://localhost:4004

# Triage / visits
# Weather risk expires after this many hours without a new weather event
ENV_RISK_TTL_HOURS=24
# 'Recent visits' = visits marked completed within this many days
RECENT_VISIT_DAYS=30
VISIT_MAX_DAYS_AHEAD=180
# Visit date/time entered by nurses is local (Manila)
VISIT_TZ_OFFSET=+08:00

# ---- Messaging (RabbitMQ) ----
# rabbitmq = publish/consume through the broker (docker compose sets this); http = direct REST fallback without a broker
EVENT_TRANSPORT=http
AMQP_URL=amqp://eldercare:eldercare_pass@localhost:5672/eldercare
EVENT_PREFETCH=10
OUTBOX_POLL_MS=2000
OUTBOX_MAX_ATTEMPTS=10
